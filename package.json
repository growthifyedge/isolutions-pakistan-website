{
  "name": "isolutions-pakistan-visual-prototype",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "npm run build:prod",
    "build:dev": "tsc -b && vite build --config vite.config.ts --mode development",
    "build:prod": "tsc -b && vite build --config vite.config.ts --mode production",
    "check:hosting-env": "node scripts/check-hosting-environment.mjs",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs",
    "preview": "npm run preview:dev",
    "preview:dev": "node scripts/preview-dist.mjs development",
    "preview:prod": "node scripts/preview-dist.mjs production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vitejs/plugin-react": "latest",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "latest"
  }
}
